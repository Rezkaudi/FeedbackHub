# FeedbackHub API — example values only. Never put a real secret in this file.
#
# R-53: server addresses, the database address and secrets live here. Product
# settings never do — the sign-up rule, the feature switch and the six rate-limit
# numbers live in the database so an admin can change them with no restart.
#
# Every variable without a default stops the boot if it is missing (R-102).
#
# Copy this to `apps/api/.env` and it is read automatically — by the API and the
# worker through `import 'dotenv/config'`, and by the Prisma CLI, which finds it
# on its own. A variable already set in the real environment always wins, so a
# container ignores the file entirely. `.env` is git-ignored; this example is
# the only one that is committed.
#
# The addresses below assume the API runs on your machine and everything else
# runs as a container. Inside a container the API must use the container names
# instead — `fh-pg`, `fh-redis`, `fh-kc`, `fh-mail`. See README.md.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- where things are ---------------------------------------------------------
# Your own PostgreSQL, with whatever user and password that server has. Create
# the database once: psql -U postgres -c "CREATE DATABASE feedbackhub;"
# For the container instead, that is feedbackhub:feedbackhub on port 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedbackhub
REDIS_URL=redis://localhost:6379
APP_BASE_URL=http://localhost:4200

# --- who may call us (R-3g) ---------------------------------------------------
# No default. Empty refuses to start; "*" is refused too. An allowlist of
# everything is not an allowlist.
AUTH_ALLOWED_ORIGINS=http://localhost:4200

# --- the auth cookies (R-3f) --------------------------------------------------
# The two MAX_AGE values must match the token lifetimes set in Keycloak. If they
# drift, a cookie outlives its token or dies before it.
AUTH_COOKIE_ACCESS_NAME=at
AUTH_COOKIE_REFRESH_NAME=rt
AUTH_COOKIE_ACCESS_MAX_AGE=300
AUTH_COOKIE_REFRESH_MAX_AGE=1800
# Must include the global 'v1' prefix, and must cover both /v1/auth/refresh
# and /v1/auth/sign-out: a browser sends a cookie only to paths under its Path.
AUTH_COOKIE_REFRESH_PATH=/v1/auth
# false on localhost only.
AUTH_COOKIE_SECURE=false

# --- the identity provider (R-1, R-3b) ----------------------------------------
# The client secret belongs to the server alone: never in the front-end build,
# never in this repository with a real value.
OIDC_ISSUER_URL=http://localhost:8080/realms/feedbackhub
OIDC_CLIENT_ID=feedbackhub-api
OIDC_CLIENT_SECRET=replace-me-not-a-real-secret
OIDC_REDIRECT_URI=http://localhost:3000/v1/auth/callback

# --- mail (R-128) -------------------------------------------------------------
# SMTP_TIMEOUT has no default on purpose: the library's own default is minutes,
# which hangs the email job.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FeedbackHub <no-reply@feedbackhub.local>
SMTP_TIMEOUT=10
# Off in development: the message goes to the log instead of the wire.
MAIL_ENABLED=false

# --- limits (R-96) ------------------------------------------------------------
# The ceiling on one request body. Separate from the admin's own rate limits.
REQUEST_BODY_LIMIT=1mb

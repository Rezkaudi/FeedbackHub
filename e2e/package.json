{
  "name": "@feedbackhub/e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Complete FeedbackHub end-to-end test suite using Cypress.",
  "scripts": {
    "test": "cypress run",
    "test:headed": "cypress run --headed --browser chrome",
    "test:open": "cypress open",
    "test:chrome": "cypress run --browser chrome",
    "test:electron": "cypress run --browser electron",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "cypress": "^15.21.1",
    "typescript": "^5.8.3"
  }
}
